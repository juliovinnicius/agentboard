# Copy to .env and adjust for your machine. Never commit .env.

# PostgreSQL connection string used by Prisma (CLI and runtime client).
# Must match the credentials in the repository root .env used by docker-compose.
DATABASE_URL="postgresql://agentboard:CHANGE_ME@localhost:5432/agentboard?schema=public"

# HTTP port the NestJS server listens on.
PORT=3001

# Comma-separated list of allowed browser origins, or * to allow any.
CORS_ORIGIN=http://localhost:3000

# development | test | production
NODE_ENV=development
